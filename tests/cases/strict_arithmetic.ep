main: () = {
    a := 10;
    b := 3;

    sum := a + b;
    diff := a - b;
    prod := a * b;
    quot := a / b;
    rem := a % b;

    a += 5;
    a -= 2;
    a *= 2;
    a++;
    a--;

    shifted := 1 << 4;
    shifted >>= 1;

    std::cout << "sum=(sum)$ diff=(diff)$ prod=(prod)$ quot=(quot)$ rem=(rem)$\n";
    std::cout << "a=(a)$ shifted=(shifted)$\n";
}

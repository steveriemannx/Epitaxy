#include <iostream>
#include <string>

shape: @interface type = {
    area: (this) -> double;
    name: (this) -> std::string;
}

circle: type = {
    this: shape;
    radius: double = 1.0;

    operator=: (out this, r: double) = { radius = r; }

    area: (override this) -> double = 3.14159 * radius * radius;
    name: (override this) -> std::string = "circle";
}

poly_area: (s: *shape) -> double = s*.area();

main: () = {
    c: circle = (2.0);
    std::cout << "name: (c.name())$\n";
    p: *shape = c&;
    std::cout << "area: (poly_area(p))$\n";
}
